APP_NAME="Laundry POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of THIS Laravel backend (used for logo/file URLs).
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundry_pos
DB_USERNAME=root
DB_PASSWORD=

# --- Frontend / CORS / Sanctum -------------------------------------------
# Extra origins allowed to call the API from another domain (future mobile /
# desktop shells). The built-in web app is same-origin and needs no entry.
FRONTEND_URL=http://localhost:8000
# Hosts that use cookie (session) auth: the host:port you open the app on.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Minutes before personal access tokens expire (blank = never).
SANCTUM_TOKEN_EXPIRATION=
# Cookie domain. Leave null for localhost; in production use e.g. .example.com
SESSION_DOMAIN=null
# Proxies trusted for X-Forwarded-* headers (aaPanel Nginx). Use * only behind a firewall.
TRUSTED_PROXIES=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Web app (resources/js) ----------------------------------------------
VITE_APP_NAME="${APP_NAME}"
# Same-origin by default. Only set a full URL if the API lives elsewhere.
VITE_API_BASE_URL=/api/v1
# "cookie" (session, recommended for the built-in web app) or "token" (Bearer)
VITE_AUTH_MODE=cookie
