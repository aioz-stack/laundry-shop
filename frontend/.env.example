# Base URL of the Laravel API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# "cookie" = Sanctum SPA session (browser on a stateful domain, recommended)
# "token"  = Sanctum personal access token (Capacitor / Electron / other domains)
VITE_AUTH_MODE=cookie

VITE_APP_NAME="Laundry POS"
